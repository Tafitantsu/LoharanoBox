# .env - variables d'environnement pour LoharanoBox

# Nom du projet et version
PROJECT_NAME=LoharanoBox
VERSION=1.0.0

# Base de données PostgreSQL
# Format : postgresql+psycopg2://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
DATABASE_URI=postgresql+psycopg2://LB_user:Password123@192.168.239.128:5432/Loharano_db

# CORS - origines autorisées (séparer par des virgules)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# JWT
SECRET_KEY=8d25c1becc0543ac985e7e7035de8935f715c149d6f44fd9ab27c1bca4c842f5
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Autres settings selon besoin

#superadmin
ADMIN_EMAIL=admin@loharano.mg
ADMIN_PASSWORD=Passw00rd

# Logging
LOG_LEVEL=info
